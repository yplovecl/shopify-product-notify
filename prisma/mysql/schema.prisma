// 线上 MariaDB。本地开发用 prisma/schema.prisma（SQLite），不要用这个文件跑 pnpm dev。
// 生成与迁移：pnpm run setup:production

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?   @db.Text
  expires             DateTime?
  accessToken         String    @db.Text
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?   @db.VarChar(254)
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?   @db.Text
  refreshTokenExpires DateTime?
}

model Subscriber {
  id        Int      @id @default(autoincrement())
  shop      String
  email     String   @db.VarChar(254)
  createdAt DateTime @default(now())

  @@unique([shop, email])
}

model ShopSender {
  shop      String   @id
  fromName  String   @default("")
  fromEmail String   @db.VarChar(254)
  updatedAt DateTime @updatedAt
}

// 每个店铺只能绑定一个发件域名。更换必须先删除再添加。
model ShopDomain {
  shop      String   @id
  resendId  String   @db.VarChar(64)
  name      String   @unique @db.VarChar(253)
  status    String   @db.VarChar(32)
  region    String   @db.VarChar(32)
  records   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CustomerDataRequest {
  id               Int       @id @default(autoincrement())
  shop             String
  email            String    @db.VarChar(254)
  shopifyRequestId String?   @db.VarChar(64)
  found            Boolean
  subscribedAt     DateTime?
  createdAt        DateTime  @default(now())

  @@index([shop, createdAt])
}
