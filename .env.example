# Shopify CLI（shopify app dev）会写入 SHOPIFY_API_KEY、SHOPIFY_API_SECRET、SCOPES、SHOPIFY_APP_URL。

# 仅线上 MariaDB 需要。本地 pnpm dev 使用 prisma/dev.sqlite，不要设置这项。
# DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/product_notify"

# Resend API Key：https://resend.com/api-keys
# 各店铺的发件名称和邮箱在后台「发件设置」里单独保存，不使用全局发件人。
RESEND_API_KEY=
